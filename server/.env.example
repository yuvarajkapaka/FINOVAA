# FINOVA Server Environment Variables
# Port for Express server
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed frontend origin(s) for CORS. In production (e.g. Render), set this to your Vercel URL:
# Example: CLIENT_ORIGIN=https://finova.vercel.app
# Multiple origins can be comma-separated: CLIENT_ORIGIN=https://finova.vercel.app,https://finova-staging.vercel.app
CLIENT_ORIGIN=

# Path to SQLite database file. Configurable for Render persistent disks (e.g. /var/data/finova.db):
DB_PATH=./data/finova.db
